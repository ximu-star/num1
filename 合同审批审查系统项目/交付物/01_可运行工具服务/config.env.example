# ============================================================
# 合同审批审查系统 · 统一配置模板
# 1. 复制为 config.env
# 2. 填写需要使用的 URL / Token / API Key
# 3. 运行 python apply_config.py
# 4. 重启 8001 / 8002
#
# 默认是最小可运行配置：SQLite + 本地存储 + MinerU mock + Milvus 关闭
# ============================================================

# ---------------- 8001 业务服务 ----------------
CONTRACT_DATABASE_URL=sqlite:///./contract_review.db
CONTRACT_API_HOST=127.0.0.1
CONTRACT_API_PORT=8001
CONTRACT_INTERNAL_SERVICE_TOKEN=contract-internal-token

# 飞书：mock=本地演示；real=真实飞书（需要 APP_ID / APP_SECRET）
CONTRACT_FEISHU_MODE=mock
CONTRACT_FEISHU_APP_ID=
CONTRACT_FEISHU_APP_SECRET=
CONTRACT_FEISHU_BASE_URL=https://open.feishu.cn/open-apis

# MinerU：mock=读同名 .md；api=云端；cli=本地命令
CONTRACT_MINERU_MODE=mock
CONTRACT_MINERU_TRANSPORT=auto
CONTRACT_MINERU_TOKEN=
CONTRACT_MINERU_BASE_URL=https://mineru.net/api/v4
CONTRACT_MINERU_MODEL_VERSION=vlm
CONTRACT_MINERU_CLI_COMMAND=mineru
CONTRACT_MINERU_POLL_INTERVAL_SECONDS=3
CONTRACT_MINERU_TIMEOUT_SECONDS=300

# Word → PDF：LibreOffice 路径；留空自动查找
CONTRACT_SOFFICE_PATH=

# 存储：local=本地目录；minio=对象存储
CONTRACT_STORAGE_MODE=local
CONTRACT_STORAGE_DIR=./storage
CONTRACT_MINIO_ENDPOINT=
CONTRACT_MINIO_ACCESS_KEY=
CONTRACT_MINIO_SECRET_KEY=
CONTRACT_MINIO_BUCKET=contract-review
CONTRACT_MINIO_SECURE=false
CONTRACT_MINIO_AUTO_CLOCK_SYNC=true
CONTRACT_MINIO_CLOCK_OFFSET_SECONDS=0

# Milvus：未启用时只跑 PG 确定性规则
CONTRACT_MILVUS_ENABLED=false
CONTRACT_MILVUS_URL=
CONTRACT_MILVUS_COLLECTION=contract_manual_chunks
CONTRACT_BGE_M3_PATH=
CONTRACT_BGE_DEVICE=cpu
CONTRACT_BGE_DTYPE=bfloat16
CONTRACT_BGE_BATCH_SIZE=8
CONTRACT_SEMANTIC_TOP_K=3
CONTRACT_SEMANTIC_SCORE_THRESHOLD=0.55

CONTRACT_SEED_ON_STARTUP=true
CONTRACT_SCHEDULER_ENABLED=true
CONTRACT_SCHEDULER_INTERVAL_SECONDS=60
CONTRACT_COMMENT_MAX_LENGTH=3000

# ---------------- 8002 AI 服务 ----------------
AI_DATABASE_URL=sqlite+aiosqlite:///./ai_service.db
API_HOST=0.0.0.0
API_PORT=8002
INTERNAL_SERVICE_TOKEN=contract-internal-token
CONTRACT_REVIEW_BASE_URL=http://127.0.0.1:8001
CONTRACT_REVIEW_INTERNAL_TOKEN=contract-internal-token
CONTRACT_REVIEW_TIMEOUT_SECONDS=30
JWT_SECRET=replace-this-demo-secret
JWT_ALGORITHM=HS256

# LLM：8002 Agent 需要真实 Key；只跑 8001 规则可以不填
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_THINKING_MODE=disabled
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# ============================================================
# 切换到 PostgreSQL 示例（先创建数据库）：
# CONTRACT_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/contract_review
# AI_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/contract_review
#
# 切换到 MinIO：
# CONTRACT_STORAGE_MODE=minio
# CONTRACT_MINIO_ENDPOINT=127.0.0.1:9000
# CONTRACT_MINIO_ACCESS_KEY=...
# CONTRACT_MINIO_SECRET_KEY=...
#
# 切换到 MinerU 云端：
# CONTRACT_MINERU_MODE=api
# CONTRACT_MINERU_TOKEN=...
#
# 启用 Milvus（需先导入手册并腾出约 1.5GB 内存）：
# CONTRACT_MILVUS_ENABLED=true
# CONTRACT_MILVUS_URL=http://127.0.0.1:19530
# CONTRACT_BGE_M3_PATH=D:/models/bge-m3
# ============================================================
