# 8002 AI Service 配置示例
# 实际配置由根目录 config.env 经 apply_config.py 生成
AI_DATABASE_URL=sqlite+aiosqlite:///./ai_service.db
API_HOST=0.0.0.0
API_PORT=8002
INTERNAL_SERVICE_TOKEN=contract-internal-token
CONTRACT_REVIEW_BASE_URL=http://127.0.0.1:8001
CONTRACT_REVIEW_INTERNAL_TOKEN=contract-internal-token
CONTRACT_REVIEW_TIMEOUT_SECONDS=30
JWT_SECRET=replace-this-demo-secret
JWT_ALGORITHM=HS256
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_THINKING_MODE=disabled
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
